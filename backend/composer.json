{
  "name": "crt01/intranet-backend",
  "description": "API REST da Intranet CRT-01",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-bundle": "^2.19",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^3.6",
    "nelmio/api-doc-bundle": "^5.6",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/flex": "^2.7",
    "symfony/framework-bundle": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/redis-messenger": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*"
  },
  "autoload": {
    "psr-4": { "App\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "App\\Tests\\": "tests/" }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "pos-install-cmd": ["@auto-scripts"],
    "pos-update-cmd": ["@auto-scripts"],
    "testar": "phpunit"
  }
}
